# DriftDS ignore list. Nothing from Nintendo and nothing personal goes in the repo.

# Game data and what is made from it (the ROM, its extracted parts, the C translated from it)
*.nds
*.srl
rom/
extracted/
generated/

# Build output
build/
*.exe
*.o
*.obj
*.pdb
*.ilk
*.elf
__pycache__/

# Personal files and logs
*.sav
settings.ini
logs/
saves/

# Tools and test copies that live in the work folder
toolchain/
test-run/
backups/

#logs from build runs
*.log

#private working notes, never committed
decisions.md

#private work folders and held back parts (remove the launcher line when the launcher is ready)
private-scripts/
launcher/

#editor folders
.vscode/
.idea/
